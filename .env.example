# Template de variáveis de ambiente para o aptdata
# Copie para .env e preencha com suas chaves

# DeepSeek API
DEEPSEEK_API_KEY=sk-sua-chave-aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini API
GEMINI_API_KEY=sua-chave-gemini-aqui
BRISA_EMBEDDING_MODEL=gemini/gemini-embedding-001

# Observabilidade
LLM_OBSERVER_ENABLED=true
